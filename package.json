{
  "name": "microverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "preview:meta": "node --env-file-if-exists=.env scripts/creature-server.mjs",
    "preview:motion": "node scripts/preview.mjs --motion",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "setup:voice": "node scripts/setup-natural-voice.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@meta-sam/parser": "0.1.0",
    "kokoro-js": "1.2.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
