# Local server only. Never put keys in app/, src/, public/ or a browser build.
MODEL_API_KEY=
# Keep these disabled until promotional credit coverage is confirmed.
MICROVERSE_META_ENABLED=0
MICROVERSE_META_CREDITS_CONFIRMED=0
# Integer millionths of a dollar. Default $0; operator sets a confirmed test cap.
# One image + one SAM cutout reserves 12500 ($0.0125).
MICROVERSE_META_CAP_MICRO_USD=0

# Reasoning is configured separately. Pick one funded provider; no auto-fallback.
MICROVERSE_SPARK_PROVIDER=meta
BASETEN_API_KEY=
MICROVERSE_SPARK_ENABLED=0
MICROVERSE_SPARK_CREDITS_CONFIRMED=0
# Each bounded reasoning call reserves 25000 ($0.025); default stays paused.
MICROVERSE_SPARK_CAP_MICRO_USD=0

# Optional local Kokoro narrator: run npm run setup:voice first. No paid API.
MICROVERSE_LOCAL_VOICE_ENABLED=0
# Separate Meta question transcription; at most 15s per explicit send.
MICROVERSE_VOICE_ENABLED=0
MICROVERSE_VOICE_CREDITS_CONFIRMED=0
# $0.001 reserved per clip; 10000 is a $0.01 local ceiling (10 attempts).
MICROVERSE_VOICE_CAP_MICRO_USD=0
